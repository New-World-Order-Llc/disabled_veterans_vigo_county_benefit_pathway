import json
import hashlib
import time
from dataclasses import dataclass

@dataclass
class FinalizationComponent:
    name: str
    payload: dict
    checksum: str
    timestamp: int

def compute_checksum(payload):
    encoded = json.dumps(payload, sort_keys=True).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()

def finalize_system(components: list):
    final_packet = {
        "finalization_timestamp": int(time.time()),
        "components": [],
        "system_integrity": True
    }

    for comp in components:
        valid = compute_checksum(comp.payload) == comp.checksum

        final_packet["components"].append({
            "name": comp.name,
            "timestamp": comp.timestamp,
            "checksum_valid": valid,
            "payload_keys": list(comp.payload.keys())
        })

        if not valid:
            final_packet["system_integrity"] = False

    final_packet["finalization_checksum"] = compute_checksum(final_packet)
    final_packet["sealed"] = True

    return final_packet

def demo():
    intake_payload = {"member": "DAO Veteran Member", "disability_rating": 70}
    eligibility_payload = {"VA Disability Compensation": True}
    activation_payload = {"VA Disability Compensation": "APPROVED"}
    export_payload = {"casefile_exported": True}
    verification_payload = {"chain_integrity": True}

    components = [
        FinalizationComponent(
            name="Intake",
            payload=intake_payload,
            checksum=compute_checksum(intake_payload),
            timestamp=int(time.time())
        ),
        FinalizationComponent(
            name="Eligibility",
            payload=eligibility_payload,
            checksum=compute_checksum(eligibility_payload),
            timestamp=int(time.time())
        ),
        FinalizationComponent(
            name="Activation",
            payload=activation_payload,
            checksum=compute_checksum(activation_payload),
            timestamp=int(time.time())
        ),
        FinalizationComponent(
            name="Export",
            payload=export_payload,
            checksum=compute_checksum(export_payload),
            timestamp=int(time.time())
        ),
        FinalizationComponent(
            name="ChainVerification",
            payload=verification_payload,
            checksum=compute_checksum(verification_payload),
            timestamp=int(time.time())
        )
    ]

    print(json.dumps(finalize_system(components), indent=2))

if __name__ == "__main__":
    demo()
