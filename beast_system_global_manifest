import json
import time
import hashlib
from dataclasses import dataclass

@dataclass
class GlobalManifestSection:
    name: str
    payload: dict
    checksum: str
    timestamp: int

def compute_checksum(payload):
    encoded = json.dumps(payload, sort_keys=True).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()

class BeastGlobalManifest:
    def __init__(self):
        self.sections = []

    def add_section(self, name, payload):
        timestamp = int(time.time())
        checksum = compute_checksum(payload)

        section = GlobalManifestSection(
            name=name,
            payload=payload,
            checksum=checksum,
            timestamp=timestamp
        )

        self.sections.append(section)

        return {
            "section": name,
            "checksum": checksum,
            "timestamp": timestamp,
            "sealed": True
        }

    def generate_manifest(self):
        timestamp = int(time.time())

        manifest_payload = {
            "system": "Beast System 3.0",
            "generated_timestamp": timestamp,
            "sections": {
                section.name: {
                    "payload": section.payload,
                    "checksum": section.checksum,
                    "timestamp": section.timestamp
                }
                for section in self.sections
            }
        }

        manifest_payload["global_checksum"] = compute_checksum(manifest_payload)
        manifest_payload["sealed"] = True

        return manifest_payload

