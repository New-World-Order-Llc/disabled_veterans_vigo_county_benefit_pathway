import json
import time
import hashlib
from dataclasses import dataclass

@dataclass
class AnchorRecord:
    subsystem: str
    activation_checksum: str
    wallet_address: str
    anchor_timestamp: int
    anchor_id: str

def compute_checksum(payload):
    encoded = json.dumps(payload, sort_keys=True).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()

class BeastChainAnchor:
    def __init__(self, wallet_address):
        self.wallet_address = wallet_address
        self.anchor_log = []

    def anchor_activation(self, subsystem_name, activation_packet):
        timestamp = int(time.time())

        activation_checksum = compute_checksum(activation_packet)
        anchor_id = f"{subsystem_name}-{activation_checksum[:12]}-{timestamp}"

        record = AnchorRecord(
            subsystem=subsystem_name,
            activation_checksum=activation_checksum,
            wallet_address=self.wallet_address,
            anchor_timestamp=timestamp,
            anchor_id=anchor_id
        )

        self.anchor_log.append(record)

        return {
            "subsystem": subsystem_name,
            "wallet_address": self.wallet_address,
            "activation_checksum": activation_checksum,
            "anchor_id": anchor_id,
            "anchor_timestamp": timestamp,
            "sealed": True
        }

    def export_anchor_manifest(self):
        manifest = {
            "system": "Beast System 3.0",
            "wallet_address": self.wallet_address,
            "anchors": [
                {
                    "subsystem": r.subsystem,
                    "activation_checksum": r.activation_checksum,
                    "anchor_id": r.anchor_id,
                    "anchor_timestamp": r.anchor_timestamp
                }
                for r in self.anchor_log
            ],
            "export_timestamp": int(time.time())
        }

        manifest["sovereign_checksum"] = compute_checksum(manifest)
        manifest["sealed"] = True

        return manifest

