import json
import hashlib
import time
from dataclasses import dataclass

@dataclass
class CompletionComponent:
    name: str
    checksum: str
    timestamp: int

def compute_checksum(payload):
    encoded = json.dumps(payload, sort_keys=True).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()

def generate_completion_manifest(components: list):
    manifest = {
        "completion_timestamp": int(time.time()),
        "components": [],
        "system_complete": True
    }

    for comp in components:
        manifest["components"].append({
            "name": comp.name,
            "checksum": comp.checksum,
            "timestamp": comp.timestamp
        })

    manifest["final_checksum"] = compute_checksum(manifest)
    manifest["sealed"] = True

    return manifest

def demo():
    # Example components representing final sealed states
    intake = CompletionComponent(
        name="Intake",
        checksum=compute_checksum({"member": "DAO Veteran Member"}),
        timestamp=int(time.time())
    )

    eligibility = CompletionComponent(
        name="Eligibility",
        checksum=compute_checksum({"VA Disability Compensation": True}),
        timestamp=int(time.time())
    )

    activation = CompletionComponent(
        name="Activation",
        checksum=compute_checksum({"VA Disability Compensation": "APPROVED"}),
        timestamp=int(time.time())
    )

    export = CompletionComponent(
        name="Export",
        checksum=compute_checksum({"casefile_exported": True}),
        timestamp=int(time.time())
    )

    verification = CompletionComponent(
        name="ChainVerification",
        checksum=compute_checksum({"chain_integrity": True}),
        timestamp=int(time.time())
    )

    print(json.dumps(generate_completion_manifest(
        [intake, eligibility, activation, export, verification]
    ), indent=2))

if __name__ == "__main__":
    demo()
