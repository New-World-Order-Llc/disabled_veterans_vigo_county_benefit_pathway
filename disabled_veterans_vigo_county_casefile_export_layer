from dataclasses import dataclass
import json
import time
import hashlib

@dataclass
class CasefileRecord:
    member_name: str
    dob: str
    disability_rating: int
    programs: list
    casefile: dict
    timestamp: int

def generate_checksum(payload: dict):
    encoded = json.dumps(payload, sort_keys=True).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()

def export_casefile(record: CasefileRecord):
    export_packet = {
        "member": {
            "name": record.member_name,
            "dob": record.dob,
            "disability_rating": record.disability_rating
        },
        "programs": record.programs,
        "casefile": record.casefile,
        "export_timestamp": int(time.time())
    }

    export_packet["integrity_checksum"] = generate_checksum(export_packet)

    return export_packet

