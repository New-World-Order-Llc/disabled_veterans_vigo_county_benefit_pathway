import json
import time
from dataclasses import dataclass

@dataclass
class SubsystemDescriptor:
    name: str
    version: str
    checksum: str
    registered_timestamp: int

def compute_checksum(payload):
    encoded = json.dumps(payload, sort_keys=True).encode("utf-8")
    import hashlib
    return hashlib.sha256(encoded).hexdigest()

class SovereignSystemManifest:
    def __init__(self):
        self.subsystems = {}
        self.generated_timestamp = None

    def register_subsystem(self, name, version="1.0.0"):
        timestamp = int(time.time())
        descriptor_payload = {
            "name": name,
            "version": version,
            "timestamp": timestamp
        }
        checksum = compute_checksum(descriptor_payload)

        descriptor = SubsystemDescriptor(
            name=name,
            version=version,
            checksum=checksum,
            registered_timestamp=timestamp
        )

        self.subsystems[name] = descriptor

