import json
import time
import hashlib
from dataclasses import dataclass

@dataclass
class GovernanceStreamEvent:
    event_type: str
    subsystem: str
    payload: dict
    timestamp: int
    checksum: str

def compute_checksum(payload):
    encoded = json.dumps(payload, sort_keys=True).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()

class BeastContinuousGovernanceStream:
    def __init__(self):
        self.stream = []

    def emit(self, event_type, subsystem_name, payload):
        timestamp = int(time.time())
        payload = payload or {}

        event_payload = {
            "event_type": event_type,
            "subsystem": subsystem_name,
            "payload": payload,
            "timestamp": timestamp
        }

        checksum = compute_checksum(event_payload)

        event = GovernanceStreamEvent(
            event_type=event_type,
            subsystem=subsystem_name,
            payload=payload,
            timestamp=timestamp,
            checksum=checksum
        )

        self.stream.append(event)

        return {
            "event_type": event_type,
            "subsystem": subsystem_name,
            "timestamp": timestamp,
            "checksum": checksum,
            "sealed": True
        }

    def export_stream(self):
        manifest = {
            "system": "Beast System 3.0",
            "events": [
                {
                    "event_type": e.event_type,
                    "subsystem": e.subsystem,
                    "payload": e.payload,
                    "timestamp": e.timestamp,
                    "checksum": e.checksum
                }
                for e in self.stream
            ],
            "export_timestamp": int(time.time())
        }

        manifest["stream_checksum"] = compute_checksum(manifest)
        manifest["sealed"] = True

        return manifest

def demo():
    stream = BeastContinuousGovernanceStream()

    stream.emit(
        "LIFECYCLE_TRANSITION",
        "beast_system_lifecycle_controller",
        {"phase": "OPERATIONAL"}
    )

    stream.emit(
        "RESILIENCE_EVENT",
        "beast_system_resilience_matrix",
        {"state": "DEGRADED", "action": "INITIATE_STABILIZATION"}
    )

    stream.emit(
        "ACTIVATION_UPDATE",
        "beast_system_global_activation_packet",
        {"activation_state": "FULL_SYSTEM_ACTIVE"}
    )

    print("GOVERNANCE STREAM:")
    print(json.dumps(stream.export_stream(), indent=2))

if __name__ == "__main__":
    demo()
