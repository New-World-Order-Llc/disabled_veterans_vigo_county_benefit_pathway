from dataclasses import dataclass
import time

@dataclass
class VeteranIntake:
    full_name: str
    dob: str
    address: str
    phone: str
    email: str
    service_branch: str
    disability_rating: int
    dd214_on_file: bool
    income_monthly: float
    household_size: int

@dataclass
class ActivationPacket:
    program: str
    activation_state: str
    office_name: str
    office_address: str
    office_phone: str
    documents_verified: bool
    timestamp: int

def generate_casefile(intake: VeteranIntake, activation_packets: list):
    casefile = {
        "member": {
            "name": intake.full_name,
            "dob": intake.dob,
            "address": intake.address,
            "phone": intake.phone,
            "email": intake.email,
            "service_branch": intake.service_branch,
            "disability_rating": intake.disability_rating,
            "dd214_on_file": intake.dd214_on_file
        },
        "household": {
            "income_monthly": intake.income_monthly,
            "household_size": intake.household_size
        },
        "program_activations": [],
        "casefile_timestamp": int(time.time())
    }

    for packet in activation_packets:
        casefile["program_activations"].append({
            "program": packet.program,
            "activation_state": packet.activation_state,
            "office": {
                "name": packet.office_name,
                "address": packet.office_address,
                "phone": packet.office_phone
            },
            "documents_verified": packet.documents_verified,
            "activation_timestamp": packet.timestamp
        })

    return casefile

